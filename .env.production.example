# Production env-file for the Hetzner VPS. Copy to `.env` on the server:
#   cp .env.production.example .env
# Then fill in real values. Never commit `.env`.

# ProductHunt Developer Token
PH_TOKEN=

# Anthropic API Key for Claude summaries
ANTHROPIC_API_KEY=

# HTTP Basic Auth — credentials the browser will prompt for.
AUTH_USER=
AUTH_PASS=

# Snapshot endpoint token — generate with: openssl rand -hex 32
SNAPSHOT_TOKEN=
