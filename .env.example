# Copy to .env.local and fill in values. Never commit .env.local.

# ProductHunt Developer Token — generate at producthunt.com/v2/oauth/applications
# (create an app, redirect URI can be https://localhost:8424/callback, then "Generate Token")
PH_TOKEN=

# Anthropic API Key for Claude summaries (Phase 7+)
ANTHROPIC_API_KEY=

# HTTP Basic Auth (Phase 9). Set DISABLE_AUTH=true locally to skip auth during dev.
AUTH_USER=
AUTH_PASS=
DISABLE_AUTH=true
