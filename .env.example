# Copy to .env.local and fill in values. Never commit .env.local.

# ProductHunt Developer Token — generate at producthunt.com/v2/oauth/applications
# (create an app, redirect URI can be https://localhost:8424/callback, then "Generate Token")
PH_TOKEN=

# Anthropic API Key for Claude summaries (Phase 7+)
ANTHROPIC_API_KEY=

# HTTP Basic Auth (Phase 9). Set DISABLE_AUTH=true locally to skip auth during dev.
# On the production server, remove DISABLE_AUTH (or set to false) and set real credentials.
AUTH_USER=
AUTH_PASS=
DISABLE_AUTH=true

# Token for /api/snapshot/* — used by external schedulers (cron, GitHub Action)
# so the snapshot endpoint can be hit without Basic Auth. Generate via
# `openssl rand -hex 32` and store as the X-Snapshot-Token header value.
SNAPSHOT_TOKEN=
