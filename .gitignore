# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — block .env.local etc., but commit *.example templates
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite (project DB lives in db/data.db, journal/wal/shm are runtime artifacts)
*.db
*.db-journal
*.db-wal
*.db-shm

# generated daily digests (Phase 8)
/digests

# claude code — local-only personal settings
.claude/settings.local.json
